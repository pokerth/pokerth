#!/usr/bin/env bash

# Canonical build-time version definitions for PokerTH.
# This is the single source of truth. Scripts and CMake reference this file; if a build fails on a version (e.g. QT_VERSION, ANDROID_MIN_SDK_VERSION), edit here.
# Sourced by: scripts/functions.sh, scripts/build_android.sh, docker/linux/create_appimage_deploy.sh, docker/windows/build_windows.sh.
# CACHE_ROOT: ~/.pokerth (native) or /opt/pokerth (IN_DOCKER=1); devcontainer bind-mounts host ~/.pokerth → /opt/pokerth. Platforms: CACHE_ROOT/{android,windows}. See functions.sh.
#
# NOTE:
# - Values here are simple shell assignments (no spaces around '=').
# - Scripts should treat missing variables as an error and fail-fast rather than guessing.
# - Product/app version (e.g. 2.0.6) is not here; use game_defs.h / git describe when ready.

# Qt: version we install (aqtinstall). Minimum Qt version is in CMakeLists.txt (single source there).
QT_VERSION=6.9.3

# CMake minimum required (for reference; actual check is in CMakeLists.txt)
CMAKE_MINIMUM_REQUIRED_VERSION=3.15

# appimagetool version used by docker/linux/create_appimage_deploy.sh
APPIMAGETOOL_VERSION=continuous

# Android SDK levels (min/target); used by docker/android build scripts and Qt Android CMake
ANDROID_MIN_SDK_VERSION=28
ANDROID_TARGET_SDK_VERSION=35

# Android SDK/NDK/Gradle versions (used by setup_android.sh and Dockerfile)
ANDROID_NDK_VERSION=28.0.13004108
ANDROID_BUILD_TOOLS_VERSION=33.0.2
ANDROID_CMAKE_VERSION=3.22.1
ANDROID_CMDLINE_TOOLS_VERSION=9477386
GRADLE_VERSION=8.3

# Flatpak KDE runtime/sdk version (e.g. org.kde.Platform//6.9)
FLATPAK_RUNTIME_VERSION=6.9

# macOS deployment target (minimum OS version for the built app)
MACOSX_DEPLOYMENT_TARGET=12.0
