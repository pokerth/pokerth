// Windows resources of the client exes: app icon and version info.
// Template for cmake/PokerthWindowsResource.cmake, which generates one .rc per
// client. SignPath (docker/windows/signpath/) only signs exes whose
// ProductName and ProductVersion match, so keep those two in sync with the
// installer.
#include <winver.h>

IDI_ICON1			ICON	DISCARDABLE		"@POKERTH_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @POKERTH_RC_FILE_VERSION_COMMAS@,0
 PRODUCTVERSION  @POKERTH_RC_PRODUCT_VERSION_COMMAS@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "PokerTH Team"
            VALUE "FileDescription",  "@POKERTH_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@POKERTH_RC_FILE_VERSION@"
            VALUE "InternalName",     "@POKERTH_RC_TARGET@"
            VALUE "LegalCopyright",   "Copyright (C) PokerTH Team. Licensed under the AGPL-3.0."
            VALUE "OriginalFilename", "@POKERTH_RC_TARGET@.exe"
            VALUE "ProductName",      "PokerTH"
            VALUE "ProductVersion",   "@POKERTH_RC_PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
