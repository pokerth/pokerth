<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Discworld QML table style - a poker table in the "Mended Drum",
   Ankh-Morpork.

   The table graphic shows the table in the middle of the image, hence the
   center mode: the client centres the image on the middle of the player
   ellipse. table.png is cropped so that the table top (the engraved surface
   inside the wooden rim) matches the size and image position of the danuxi felt
   exactly - 1274 px wide, centre (783, 477) - so the player ellipse sits on the
   table edge just the same at the same zoom. TableBackgroundZoom is adjustable
   without a rebuild (change the value, restart the client).

   Action buttons: stained oak planks - a base gradient with grain, edge light
   at the top, a shadow edge at the bottom. Four stains instead of four signal
   colours (red/olive/golden oak/embers), so that the buttons stay
   distinguishable but look like the wood of the bar and not like varnished
   plastic.

   Pucks: tavern tokens in gold (dealer), silver (small blind) and copper (big
   blind) - an embossed rim, a recessed serif type.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Discworld QML table style" />
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="19.07.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="center" />
     <!-- Crop/zoom factor (>= 1.0): larger = a larger table / more of the outer
          border cropped away. -->
     <TableBackgroundZoom value="1.3" />

     <!-- Corner radius of the button SVGs, in units of their 168x43 drawing
          area. The client draws the state frames (preselection gold, primary
          action) as a rectangle over the SVG and needs its radius for that,
          otherwise the corners gape. Without the tag 9 applies (the radius of
          the bundled default buttons). -->
     <ActionButtonBorderRadius value="7" />

     <!-- Accent colour of the player boxes: the gold of the table engraving,
          averaged directly from table.png (candlelight gold, not a pure
          yellow). It tints the gradient and the frame of the box and matches
          the carving, the lamps and the fireplace. -->
     <PlayerBoxAccent value="#c98d49" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- All four stains are dark - a light, slightly yellowed label
          (parchment) instead of the colour derived from the gradient stops. -->
     <FoldButtonTextColor value="#f4e2c0" />
     <CheckCallButtonTextColor value="#f4e2c0" />
     <BetRaiseButtonTextColor value="#f8e8c4" />
     <AllInButtonTextColor value="#f9e4bd" />

     <!-- Colours of the chat and log box (the floating side panels at the
          table). Deliberately independent of the light/dark mode of the
          application. A dark brown like the planks of the taproom, the frame in
          <PlayerBoxAccent> - chat/log box and player boxes carry the same
          accent. -->
     <ChatLogBackground value="#150e08" />     <!-- Panel background -->
     <ChatLogSurface value="#241811" />        <!-- Input field / chat bubble -->
     <ChatLogBorder value="#7a5526" />         <!-- Frame / separator -->
     <ChatLogText value="#f2e2c6" />           <!-- Main text -->
     <ChatLogTextSecondary value="#d9bd90" />  <!-- Secondary text / icons -->
     <ChatLogTextMuted value="#9c7c50" />      <!-- Muted text / placeholder -->

  </TableStyle>
</PokerTH>
