<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Mute QML table style (ported from the widget client style
   data/gfx/gui/table/mute_table_01, https://www.pokerth.net).

   All UI elements are clean SVGs; only the table background stays a PNG.
   table.png was prepared so that the felt oval sits exactly centred vertically
   AND horizontally (the dark blue ground continued upwards; the vignette/lamp
   baked into the image travels along with the table) -> center mode.

   Action buttons: fold/call/raise grey, all-in red - the colours come from the
   original.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Mute QML table style" />
     <StyleMaintainerName value="mute design" />
     <StyleMaintainerEMail value="demainlespoulpes@gmail.com" />
     <StyleCreateDate value="19.06.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="center" />
     <!-- Crop/zoom factor (>= 1.0): larger = a larger table / more of the outer
          border cropped away. Adjustable without a rebuild - change the value
          and restart the client. -->
     <TableBackgroundZoom value="1.0" />

     <!-- Corner radius of the button SVGs, in units of their 168x43 drawing
          area. The client draws the state frames (preselection gold, primary
          action) as a rectangle over the SVG and needs its radius for that,
          otherwise the corners gape. Without the tag 9 applies (the radius of
          the bundled default buttons). -->
     <ActionButtonBorderRadius value="6.5" />

     <!-- Accent colour of the player boxes: the denim blue of the background.
          It tints the gradient and the frame of the box; without the tag the
          neutral default look remains. -->
     <PlayerBoxAccent value="#7ea6d0" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- Colours of the chat, history and odds box. Derived from
          <PlayerBoxAccent>: the frame carries the accent, the surfaces only a
          hint of it, the text stays neutral. Independent of the light/dark
          mode. -->
     <ChatLogBackground value="#272f3c" />    <!-- Panel background -->
     <ChatLogSurface value="#434f62" />    <!-- Input field / chat bubble -->
     <ChatLogBorder value="#6981a0" />    <!-- Frame / separator -->
     <ChatLogText value="#d6eaff" />    <!-- Main text -->
     <ChatLogTextSecondary value="#a8c6e6" />    <!-- Secondary text / icons -->
     <ChatLogTextMuted value="#6084a9" />    <!-- Muted text / placeholder -->

  </TableStyle>
</PokerTH>
