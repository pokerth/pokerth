<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Lemming TA01-MC QML table style (ported from the widget client style
   LEMMING-TABLE-01-MC, https://www.pokerth.net).

   A peculiarity compared to the other QML styles: this style has no felt oval
   at all. The table background is a dark carbon/honeycomb texture, out of whose
   lower edge white smoke rises (original: xx-muurpapier.png, 1920x1080). The
   graphic is a pure greyscale image and is therefore shipped as an 8 bit
   greyscale PNG (lossless, about 1/8 of the original size). Since the texture
   is flat, the classic cover mode is enough (no center).

   All UI elements are clean SVGs. The action buttons reproduce the signature of
   the original: a rounded rectangle shape with concave narrow sides, four soft
   glows in the corners and an (almost) transparent middle. The gradient stops
   are calibrated against the original PNGs.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Lemming TA01-MC QML table style" />
     <StyleMaintainerName value="lemming" />
     <StyleMaintainerEMail value="NULL" />
     <StyleCreateDate value="10.07.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <!-- No center mode: the honeycomb texture is flat, the smoke sits at the
          lower edge. The classic cover cuts into it the least. -->
     <TableBackgroundAlign value="bottom" />

     <!-- Corner radius of the button SVGs, in units of their 168x43 drawing
          area. The client draws the state frames (preselection gold, primary
          action) as a rectangle over the SVG and needs its radius for that,
          otherwise the corners gape. Without the tag 9 applies (the radius of
          the bundled default buttons). -->
     <ActionButtonBorderRadius value="6.5" />

     <!-- Accent colour of the player boxes: the cool grey of the monochrome
          carbon look. It tints the gradient and the frame of the box; without
          the tag the neutral default look remains. -->
     <PlayerBoxAccent value="#9aa0a6" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- The text colours MUST be given explicitly here. Without them the
          StyleProvider derives the colour from the average brightness of the
          gradient stops - which assumes an opaque button. These buttons are
          translucent with light glows though: call/raise/all-in would end up
          with an almost black text on an almost black ground. The colours match
          the coloured labels of the original. -->
     <FoldButtonTextColor value="#ff5f5f" />
     <CheckCallButtonTextColor value="#5ccfff" />
     <BetRaiseButtonTextColor value="#5cff5c" />
     <AllInButtonTextColor value="#fff200" />

     <!-- Colours of the chat, history and odds box. Derived from
          <PlayerBoxAccent> as in the other styles: the frame carries the
          accent, the surfaces only a hint of it. The basis here are the own
          grey tones of the style instead of the blueish defaults - that way the
          carbon look stays monochrome. Independent of the light/dark mode. -->
     <ChatLogBackground value="#262627" />    <!-- Panel background -->
     <ChatLogSurface value="#414243" />    <!-- Input field / chat bubble -->
     <ChatLogBorder value="#777a7c" />    <!-- Frame / separator -->
     <ChatLogText value="#e6e6e6" />    <!-- Main text -->
     <ChatLogTextSecondary value="#c2c2c2" />    <!-- Secondary text / icons -->
     <ChatLogTextMuted value="#8d8e90" />    <!-- Muted text / placeholder -->

  </TableStyle>
</PokerTH>
