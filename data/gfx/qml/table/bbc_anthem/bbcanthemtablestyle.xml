<?xml version="1.0" encoding="UTF-8" ?>
<!--
   BBC Anthem QML table style
   
   Zum Andenken der -Wiederaufnahme- des BBC-Spielbetriebs am 07.08.2021
   nach dem Brand im Rechenzentrum Straßburg.

   KEIN center-Modus, sondern unten ausgerichtet
   (TableBackgroundAlign=bottom) – die Grafik muss nicht zentriert werden.

   Alle UI-Elemente sind saubere SVGs. Pucks (weiß/blau/rot) entsprechen dem
   Original; Action-Farben: Fold grau / Call grün / Raise gold / All-In rot.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="BBC Anthem QML table style" />
     <StyleMaintainerName value="BaShFX" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="07.08.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="bottom" />

     <!-- Eckenradius der Button-SVGs, in Einheiten ihrer 168x43-Zeichenfläche.
          Der Client zeichnet Zustands-Rahmen (Vorwahl gold, primäre Aktion) als
          Rechteck über das SVG und braucht dafür dessen Radius, sonst klaffen die
          Ecken. Fehlt der Tag, gilt 9 (Radius der gebündelten Default-Buttons). -->
     <ActionButtonBorderRadius value="6.5" />

     <!-- Akzentfarbe der Spielerboxen: Grau.
          Tönt Verlauf und Rahmen der Box; ohne den Tag bleibt der neutrale
          Default-Look. -->
     <PlayerBoxAccent value="#252626" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- Farben der Chat-, Verlaufs- und Chancen-Box. Aus <PlayerBoxAccent>
          abgeleitet: der Rahmen traegt den Akzent, die Flaechen nur einen
          Hauch, die Schrift bleibt neutral. Unabhaengig vom Hell/Dunkel-Modus. -->
     <ChatLogBackground value="#1c2e37" />    <!-- Panel-Hintergrund -->
     <ChatLogSurface value="#344e5c" />    <!-- Eingabefeld / Chat-Bubble -->
     <ChatLogBorder value="#397c8d" />    <!-- Rahmen / Trennlinie -->
     <ChatLogText value="#d6fcff" />    <!-- Haupttext -->
     <ChatLogTextSecondary value="#a8e1e6" />    <!-- Sekundärtext / Icons -->
     <ChatLogTextMuted value="#60a4a9" />    <!-- gedämpfter Text / Platzhalter -->

  </TableStyle>
</PokerTH>
