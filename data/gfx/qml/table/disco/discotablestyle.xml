<!--
   Disco QML table style - a poker table in the private room of a club of the
   seventies: a mirror ball above the dance floor, neon lettering, velvet and
   brass.

   The table graphic shows the table in the middle of the image, hence the
   center mode: the client centres the image on the middle of the player
   ellipse. Compared to the source (1576x998), table.png is cropped by 95 px at
   the top and 4 px at the bottom, so that the felt - the dark playing surface
   inside the wooden rim - lies exactly in the middle of the image: edges at
   x 128..1448 and y 322..576, centre (788, 449) on 1576x899. The client does
   not know an offset tag: it centres the image rigidly on communityCenterY, so
   ONLY the crop shifts the table against the community cards. Cross-check on
   the finished preview: the middle of the felt and the middle of the card row
   are 0.5 px apart.

   In table.png the mirror ball hangs 155 px lower above the dance floor than in
   the source - otherwise the upper image edge would cut it in half in landscape
   mode; its old place is closed with mirrored strips of the bead curtain.

   Action buttons: the light tiles of the dance floor - a base gradient, gloss
   on the upper half, a neon edge at the top, a shadow edge at the bottom. Fold
   deliberately carries the matt aubergine of the curtain, so that the three
   active buttons carry the neon colours: call indigo, raise magenta, all-in
   orange red.

   Pucks: the same light tiles as a square with a halo - dealer magenta, small
   blind violet, big blind orange. All colours are measured from the dance floor
   of the source.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Disco QML table style" />
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="29.08.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="center" />
     <!-- Crop/zoom factor (>= 1.0): larger = a larger table / more of the outer
          border cropped away. Adjustable without a rebuild - change the value
          and restart the client. In landscape mode higher values crop the
          mirror ball at the upper edge first. -->
     <TableBackgroundZoom value="1.0" />

     <!-- Corner radius of the button SVGs, in units of their 168x43 drawing
          area. The client draws the state frames (preselection gold, primary
          action) as a rectangle over the SVG and needs its radius for that,
          otherwise the corners gape. Without the tag 9 applies (the radius of
          the bundled default buttons). -->
     <ActionButtonBorderRadius value="7" />

     <!-- Accent colour of the player boxes: the neon magenta of the dance floor
          and of the "Good Times" lettering. It tints the gradient and the frame
          of the box; without the tag the neutral default look remains. -->
     <PlayerBoxAccent value="#d1298f" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- All four tiles are dark enough for a light label; it is tinted
          slightly towards the respective neon colour instead of being derived
          from the gradient stops. -->
     <FoldButtonTextColor value="#f0e2f8" />
     <CheckCallButtonTextColor value="#e6ecff" />
     <BetRaiseButtonTextColor value="#ffe4f4" />
     <AllInButtonTextColor value="#fff0e0" />

     <!-- Colours of the chat, history and odds box. Derived from
          <PlayerBoxAccent>: the frame carries the accent, the surfaces only a
          hint of it, the text stays neutral. Independent of the light/dark
          mode. -->
     <ChatLogBackground value="#200f2c" />     <!-- Panel background -->
     <ChatLogSurface value="#3a1d4d" />        <!-- Input field / chat bubble -->
     <ChatLogBorder value="#a4308c" />         <!-- Frame / separator -->
     <ChatLogText value="#ffe2f4" />           <!-- Main text -->
     <ChatLogTextSecondary value="#e0b0d8" />  <!-- Secondary text / icons -->
     <ChatLogTextMuted value="#a06fa8" />      <!-- Muted text / placeholder -->

  </TableStyle>
</PokerTH>
