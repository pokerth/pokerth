<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Teal QML table style (ported from the widget client style "teal_table",
   https://www.pokerth.net, by Pinboc).

   Built like the green default: a teal felt background (HD 1980x1200) with a
   lower margin. Hence NO center mode, aligned at the bottom instead
   (TableBackgroundAlign=bottom) - the graphic does not have to be centred.

   All UI elements are clean SVGs. The pucks (white/blue/gold) match the
   original; action colours: fold black / call blue / raise purple / all-in red.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Teal QML table style" />
     <StyleMaintainerName value="Pinboc" />
     <StyleMaintainerEMail value="https://pinboc.wordpress.com/" />
     <StyleCreateDate value="19.06.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="bottom" />

     <!-- Corner radius of the button SVGs, in units of their 168x43 drawing
          area. The client draws the state frames (preselection gold, primary
          action) as a rectangle over the SVG and needs its radius for that,
          otherwise the corners gape. Without the tag 9 applies (the radius of
          the bundled default buttons). -->
     <ActionButtonBorderRadius value="6.5" />

     <!-- Accent colour of the player boxes: the turquoise of the table.
          It tints the gradient and the frame of the box; without the tag the
          neutral default look remains. -->
     <PlayerBoxAccent value="#159ba6" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- Colours of the chat, history and odds box. Derived from
          <PlayerBoxAccent>: the frame carries the accent, the surfaces only a
          hint of it, the text stays neutral. Independent of the light/dark
          mode. -->
     <ChatLogBackground value="#1c2e37" />    <!-- Panel background -->
     <ChatLogSurface value="#344e5c" />    <!-- Input field / chat bubble -->
     <ChatLogBorder value="#397c8d" />    <!-- Frame / separator -->
     <ChatLogText value="#d6fcff" />    <!-- Main text -->
     <ChatLogTextSecondary value="#a8e1e6" />    <!-- Secondary text / icons -->
     <ChatLogTextMuted value="#60a4a9" />    <!-- Muted text / placeholder -->

  </TableStyle>
</PokerTH>
