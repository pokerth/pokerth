<!--
   Pirates QML table style - a poker table in a harbour tavern, rum, a nautical
   chart, a Jolly Roger and a parrot on its perch.

   The table graphic shows the table in the middle of the image, hence the
   center mode: the client centres the image on the middle of the player
   ellipse. table.png is ONLY cropped (4 px on the left, 24 px at the top), so
   that the felt - the dark cloth inside the wooden rim - lies exactly in the
   middle of the image: edges at x 144..1428 and y 362..611, centre
   (786, 486.5) on 1574x973. The client does not know an offset tag: it centres
   the image rigidly on communityCenterY, so ONLY the crop shifts the table
   against the community cards. TableBackgroundZoom is adjustable without a
   rebuild (change the value, restart the client).

   Action buttons: deck planks - a base gradient with a lengthwise grain, a
   knothole, plank joints at the ends and four iron rivets, edge light at the
   top, a shadow groove at the bottom. Four woods instead of four signal colours
   (salt bleached driftwood/tarred oak/mahogany rum barrel/red painted hull), so
   that the buttons stay distinguishable but look like ship timber.

   Pucks: the blinds are hand struck Spanish doubloons (an out-of-round blank,
   hammer marks in the rim, a beaded circle, a raised type) - the small blind
   pale and worn, the big blind a rich red gold. The dealer is a cast iron
   cannonball with a burning fuse, the mark white in the middle. The ball sits
   at the bottom left of its drawing area, so that the fuse runs into the free
   corner - that way it stays almost as large as the doubloons despite the
   fuse.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Pirates QML table style" />
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="28.07.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="center" />
     <!-- Crop/zoom factor (>= 1.0): larger = a larger table / more of the outer
          border cropped away. At 1.62:1 the image has almost the aspect ratio
          of Danuxi/Discworld (1.3 there), but the table sits flatter in the
          image here: the felt is only 26 per cent of the image height, and in
          landscape mode the image height limits the scaling. At 1.25 the player
          ellipse still stood next to the table, at 1.4 hardly anything was left
          of the taproom - with 1.33 the boxes sit on the table edge and the rum
          bottle, the parrot and the chests stay in the image (compared by
          preview runs). -->
     <TableBackgroundZoom value="1.33" />

     <!-- Corner radius of the button SVGs, in units of their 168x43 drawing
          area. The client draws the state frames (preselection gold, primary
          action) as a rectangle over the SVG and needs its radius for that,
          otherwise the corners gape. Planks are almost rectangular, only the
          edges are chipped. -->
     <ActionButtonBorderRadius value="4" />

     <!-- Accent colour of the player boxes: the brass of the storm lanterns -
          the same warm gold as the doubloons and the mounting of the glass eye.
          It tints the gradient and the frame of the box. -->
     <PlayerBoxAccent value="#cf9a34" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- All four woods are dark - a light, slightly yellowed label (the
          parchment of a nautical chart) instead of the colour derived from the
          gradient stops. -->
     <FoldButtonTextColor value="#efe6d4" />
     <CheckCallButtonTextColor value="#f1e4c9" />
     <BetRaiseButtonTextColor value="#f8dfb7" />
     <AllInButtonTextColor value="#ffe2d0" />

     <!-- Colours of the chat and log box (the floating side panels at the
          table). Deliberately independent of the light/dark mode of the
          application. A dark, tarred ship timber, the frame in
          <PlayerBoxAccent> - chat/log box and player boxes carry the same
          accent. -->
     <ChatLogBackground value="#141009" />     <!-- Panel background -->
     <ChatLogSurface value="#221a11" />        <!-- Input field / chat bubble -->
     <ChatLogBorder value="#7d5c26" />         <!-- Frame / separator -->
     <ChatLogText value="#f3e8d2" />           <!-- Main text -->
     <ChatLogTextSecondary value="#d7c096" />  <!-- Secondary text / icons -->
     <ChatLogTextMuted value="#998158" />      <!-- Muted text / placeholder -->

  </TableStyle>
</PokerTH>
