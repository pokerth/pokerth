<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Matrix QML table style - a poker table in a dark chamber, matching the card
   back "Matrix" and (by preview) the deck "Stardust Light".

   As with star_trek the table graphic shows the table centred/in perspective,
   hence the center mode: the client centres the image on the middle of the
   player ellipse. table.png is cropped so that the table surface (green felt)
   matches the size and image position of the reference (danuxi/star_trek) -
   about 1274 px wide, centre about (793,481) on 1586x992 - so the player
   ellipse sits exactly on the table edge at the same zoom. TableBackgroundZoom
   is adjustable without a rebuild (change the value, restart the client).

   Action buttons/pucks: the neutral default SVGs. Accent and panel colours in
   Matrix green. File names are relative to this XML.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Matrix QML table style" />
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="10.07.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="center" />
     <!-- Crop/zoom factor (>= 1.0): larger = a larger table / more of the outer
          border cropped away. Finally adjusted after fitting table.png. -->
     <TableBackgroundZoom value="1.25" />

     <ActionButtonBorderRadius value="9" />

     <!-- Accent colour of the player boxes: Matrix green (tinted, not neon - a
          too strong #00ff41 tips the box gradient into the garish). -->
     <PlayerBoxAccent value="#35c94a" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <!-- Action buttons: a dark, desaturated palette matching the felt + the
          card back. Raise = Matrix/felt green, call = a muted steel blue,
          fold = oxblood red (like the leather chairs), all-in = the deepest
          red. The colours sit in the SVGs; the light label is set explicitly
          (dark buttons). -->
     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />
     <FoldButtonTextColor value="#f1e8e8" />
     <CheckCallButtonTextColor value="#e9eff7" />
     <BetRaiseButtonTextColor value="#e9f5ea" />
     <AllInButtonTextColor value="#f5e4e4" />

     <!-- Chat/log box: a dark terminal green, the frame in <PlayerBoxAccent>. -->
     <ChatLogBackground value="#06120a" />     <!-- Panel background -->
     <ChatLogSurface value="#0e2314" />        <!-- Input field / chat bubble -->
     <ChatLogBorder value="#1f7a3a" />         <!-- Frame / separator -->
     <ChatLogText value="#d6ffe0" />           <!-- Main text -->
     <ChatLogTextSecondary value="#a7e6ba" />  <!-- Secondary text / icons -->
     <ChatLogTextMuted value="#5f9e74" />      <!-- Muted text / placeholder -->

  </TableStyle>
</PokerTH>
