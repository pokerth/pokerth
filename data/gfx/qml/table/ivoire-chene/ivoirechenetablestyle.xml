<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Ivoire & Chene - QML game table style (light).

   A photo of an oval table in light oak (ivory felt, a brass line, cup holders)
   in a library. The centre of the felt is the centre of the image: aligned on
   the centre of the community cards (align center). The format is identical to
   the official styles (root <PokerTH><TableStyle>): compatible with the QML
   client and the web client. File names are relative to this XML.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Ivoire - Chene" />
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="24.07.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="center" />

     <!-- Corner radius of the button SVGs (their paths round with 6.5), in
          units of the 168x43 drawing area. The client draws its state frames as
          a rectangle over them and needs the radius for that; without the tag 9
          applies and the corners gape. -->
     <ActionButtonBorderRadius value="6.5" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- The panel ground is a little deeper than the ivory felt of the table:
          that way the boxes set themselves off from the table, and light
          elements inside them (emoji symbols, avatars) get an edge. -->
     <ChatLogBackground value="#ece0c9" />
     <ChatLogSurface value="#ddceb0" />
     <ChatLogBorder value="#b89a6c" />
     <ChatLogText value="#3a2c1a" />
     <ChatLogTextSecondary value="#5d4a30" />
     <ChatLogTextMuted value="#6f5a3c" />

     <!-- Content colours of the same boxes. Without these tags the client would
          take the defaults matching the background brightness; here they are
          tuned to oak/ivory (contrast >= 4.5:1 on #ece0c9). -->
     <ChatLogAccent value="#7a5a12" />       <!-- Title, active tab, mention -->
     <ChatLogWinner value="#6b4e0a" />       <!-- Winner of the main pot -->
     <ChatLogWinnerSide value="#7d5e20" />   <!-- Winner of a side pot -->
     <ChatLogBoard value="#a8431a" />        <!-- Flop/turn/river, sits out -->
     <ChatLogSend value="#0c6b30" />         <!-- Send icon -->

  </TableStyle>
</PokerTH>
