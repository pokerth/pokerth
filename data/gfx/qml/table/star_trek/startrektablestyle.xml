<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Star Trek QML table style - a poker table on the bridge, matching the card
   deck and the card back of the same name.

   The table graphic shows the table in the middle of the image, hence the
   center mode: the client centres the image on the middle of the player
   ellipse. table.png is cropped so that the table surface (the LCARS screen)
   matches the size and image position of the danuxi felt exactly - 1274 px
   wide, centre (783, 477) - so the player ellipse sits on the table edge just
   the same at the same zoom. TableBackgroundZoom is adjustable without a
   rebuild (change the value, restart the client).

   Action buttons: LCARS bars - a flat surface, no gradient, no glow, on the
   left the separated cap with the typical gap. The colours come from the
   classic LCARS palette (red/salmon, ice, butterscotch, orange). Since LCARS
   bars carry a dark label, the text colours are set explicitly below.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Star Trek QML table style" />
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="10.07.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="center" />
     <!-- Crop/zoom factor (>= 1.0): larger = a larger table / more of the outer
          border cropped away. -->
     <TableBackgroundZoom value="1.3" />

     <!-- Corner radius of the button SVGs, in units of their 168x43 drawing
          area. The client draws the state frames (preselection gold, primary
          action) as a rectangle over the SVG and needs its radius for that,
          otherwise the corners gape. Without the tag 9 applies (the radius of
          the bundled default buttons). -->
     <ActionButtonBorderRadius value="21.5" />

     <!-- Accent colour of the player boxes: the blue of the bridge consoles. It
          tints the gradient and the frame of the box. Deliberately NOT the
          orange of the raise button: the base tone of the box is blue grey, a
          strong orange tint tips it into the brownish. -->
     <PlayerBoxAccent value="#4d9cff" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- Without these tags the StyleProvider derives the text colour from the
          average brightness of the gradient stops. The LCARS bars are flat and
          light though - what is wanted is the dark label of the original. -->
     <FoldButtonTextColor value="#10131a" />
     <CheckCallButtonTextColor value="#10131a" />
     <BetRaiseButtonTextColor value="#10131a" />
     <AllInButtonTextColor value="#10131a" />

     <!-- Colours of the chat and log box (the floating side panels at the
          table). Deliberately independent of the light/dark mode of the
          application. A dark console blue like the displays in the background,
          the frame in <PlayerBoxAccent> - chat/log box and player boxes carry
          the same accent. -->
     <ChatLogBackground value="#080b12" />     <!-- Panel background -->
     <ChatLogSurface value="#161d2c" />        <!-- Input field / chat bubble -->
     <ChatLogBorder value="#527db5" />         <!-- Frame / separator -->
     <ChatLogText value="#d6e8ff" />           <!-- Main text -->
     <ChatLogTextSecondary value="#a7c6e8" />  <!-- Secondary text / icons -->
     <ChatLogTextMuted value="#6089b8" />      <!-- Muted text / placeholder -->

  </TableStyle>
</PokerTH>
