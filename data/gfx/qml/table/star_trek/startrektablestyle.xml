<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Star Trek QML table style – Pokertisch auf der Brücke, passend zum
   Kartenstapel und zur Kartenrückseite gleichen Namens.

   Die Tischgrafik zeigt den Tisch mittig im Bild, deshalb der center-Modus:
   der Client zentriert das Bild auf den Mittelpunkt der Spieler-Ellipse.
   table.png ist so beschnitten, dass die Tischfläche (der LCARS-Screen) exakt
   auf Größe und Bildposition des danuxi-Filzes liegt – 1274 px breit, Mitte
   (783, 477) – damit sitzt die Spieler-Ellipse bei gleichem Zoom genauso am
   Tischrand. TableBackgroundZoom ist ohne Neubau justierbar (Wert ändern,
   Client neu starten).

   Action-Buttons: LCARS-Bars – flache Fläche, kein Verlauf, kein Glow, links
   die abgesetzte Kappe mit der typischen Lücke. Farben aus der klassischen
   LCARS-Palette (Rot/Salmon, Ice, Butterscotch, Orange). Da LCARS-Bars dunkle
   Beschriftung tragen, sind die Textfarben unten explizit gesetzt.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Star Trek QML table style" />
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="10.07.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="center" />
     <!-- Crop-/Zoom-Faktor (>= 1.0): größer = Tisch größer / mehr Rand-Beschnitt. -->
     <TableBackgroundZoom value="1.3" />

     <!-- Eckenradius der Button-SVGs, in Einheiten ihrer 168x43-Zeichenfläche.
          Der Client zeichnet Zustands-Rahmen (Vorwahl gold, primäre Aktion) als
          Rechteck über das SVG und braucht dafür dessen Radius, sonst klaffen die
          Ecken. Fehlt der Tag, gilt 9 (Radius der gebündelten Default-Buttons). -->
     <ActionButtonBorderRadius value="21.5" />

     <!-- Akzentfarbe der Spielerboxen: Blau der Brücken-Konsolen. Tönt Verlauf
          und Rahmen der Box. Bewusst NICHT das Orange des Raise-Buttons: der
          Basiston der Box ist blaugrau, ein kräftiger Orange-Tint kippt darauf
          ins Bräunliche. -->
     <PlayerBoxAccent value="#4d9cff" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- Ohne diese Tags leitet der StyleProvider die Schriftfarbe aus der
          mittleren Helligkeit der Gradient-Stops ab. Die LCARS-Bars sind aber
          flach und hell – gewollt ist die dunkle Beschriftung des Originals. -->
     <FoldButtonTextColor value="#10131a" />
     <CheckCallButtonTextColor value="#10131a" />
     <BetRaiseButtonTextColor value="#10131a" />
     <AllInButtonTextColor value="#10131a" />

     <!-- Farben der Chat- und Log-Box (schwebende Seiten-Panels am Tisch).
          Bewusst unabhängig vom Hell/Dunkel-Modus der App. Dunkles Konsolen-
          Blau wie die Displays im Hintergrund, Rahmen in <PlayerBoxAccent> –
          Chat-/Log-Box und Spielerboxen tragen denselben Akzent. -->
     <ChatLogBackground value="#080b12" />     <!-- Panel-Hintergrund -->
     <ChatLogSurface value="#161d2c" />        <!-- Eingabefeld / Chat-Bubble -->
     <ChatLogBorder value="#527db5" />         <!-- Rahmen / Trennlinie -->
     <ChatLogText value="#e9eef7" />           <!-- Haupttext -->
     <ChatLogTextSecondary value="#c8d3e6" />  <!-- Sekundärtext / Icons -->
     <ChatLogTextMuted value="#738eb5" />      <!-- gedämpfter Text / Platzhalter -->

  </TableStyle>
</PokerTH>
