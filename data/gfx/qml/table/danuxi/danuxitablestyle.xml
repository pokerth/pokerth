<?xml version="1.0" encoding="UTF-8" ?>
<!--
   Danuxi Blue QML table style.

   QML table styles use SVG assets for scalable UI elements. The table
   background remains a PNG because it carries the original textured table art.
-->
<PokerTH>
  <TableStyle>
     <StyleDescription value="Danuxi Blue QML table style" />
     <StyleMaintainerName value="Daniel Hammer" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="18.06.2026" />
     <PokerTHStyleFileVersion value="3" />
     <Preview value="preview.png" />
     <PreviewPortrait value="preview_portrait.png" />

     <Table value="table.png" />
     <TableBackgroundAlign value="center" />
     <!-- Crop/zoom factor (>= 1.0): larger = a larger table / more of the outer
          border cropped away. Freely adjustable WITHOUT a rebuild - change the
          value and restart the client. -->
     <TableBackgroundZoom value="1.3" />

     <!-- Corner radius of the button SVGs, in units of their 168x43 drawing
          area. The client draws the state frames (preselection gold, primary
          action) as a rectangle over the SVG and needs its radius for that,
          otherwise the corners gape. Without the tag 9 applies (the radius of
          the bundled default buttons). -->
     <ActionButtonBorderRadius value="6.5" />

     <!-- Accent colour of the player boxes: the violet of the chairs (#401984),
          brightened - the original tone is too dark to stand out against the
          blue grey base tone. It tints the gradient and the frame of the box;
          without the tag the neutral default look remains. -->
     <PlayerBoxAccent value="#8a3fd6" />

     <DealerPuck value="dealerPuck.svg" />
     <SmallBlindPuck value="smallblindPuck.svg" />
     <BigBlindPuck value="bigblindPuck.svg" />

     <FoldButton value="actionFold.svg" />
     <CheckCallButton value="actionCall.svg" />
     <BetRaiseButton value="actionRaise.svg" />
     <AllInButton value="actionAllIn.svg" />

     <!-- Colours of the chat, history and odds box. Derived from
          <PlayerBoxAccent>: the frame carries the accent, the surfaces only a
          hint of it, the text stays neutral. Independent of the light/dark
          mode. -->
     <ChatLogBackground value="#28253c" />    <!-- Panel background -->
     <ChatLogSurface value="#444163" />    <!-- Input field / chat bubble -->
     <ChatLogBorder value="#6e53a2" />    <!-- Frame / separator -->
     <ChatLogText value="#ead6ff" />    <!-- Main text -->
     <ChatLogTextSecondary value="#c7a8e6" />    <!-- Secondary text / icons -->
     <ChatLogTextMuted value="#8460a9" />    <!-- Muted text / placeholder -->

  </TableStyle>
</PokerTH>
