<?xml version="1.0" encoding="UTF-8" ?>
<!--
   QML card deck style - a rebuild of the classic "Xanax" card set
   (xanax_card_deck_01) as pure SVG.

   A parchment look (a cream coloured radial gradient) with a decorative, inlaid
   octagonal frame. Two colours: diamonds/hearts red (#a80c08), spades/clubs
   black (#141414). Every card shows a large rank + a large suit symbol in the
   centre.

   Mobile first: only the UPPER corner indexes (top left + top right) - the
   vertically mirrored lower indexes of the original are deliberately left out.

   Structure (like the bundled cards/default set): 0.svg..51.svg after the
   engine index. Rank glyphs from the cards/bella_union_4c set (a uniform
   character height, no descenders), suit paths from the cards/default set. The
   card back is a style category of ITS OWN (data/gfx/qml/backside/).

   Engine index -> card (see CardImage.qml):
     Suit = floor(index / 13): 0-12 diamonds(♦), 13-25 hearts(♥), 26-38 spades(♠), 39-51 clubs(♣)
     Rank = index % 13:        0=2, 1=3, … 8=10, 9=jack, 10=queen, 11=king, 12=ace
-->
<PokerTH>
  <CardDeck>
     <StyleDescription value="Xanax parchment (QML/SVG)" />
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="08.07.2026" />
     <PokerTHStyleFileVersion value="2" />
     <Preview value="preview.png" />
     <BigIndexesActionBottom value="0" />
  </CardDeck>
</PokerTH>
