<?xml version="1.0" encoding="UTF-8" ?>
<!--
   QML card deck style (SVG).

   Inspired by the classic widget client card style "Bella Union 4 colours" by
   Julio Gomez (data/gfx/cards/<name>/...). For the QML client the cards were
   rebuilt as REAL, freely scalable vectors (0.svg..51.svg, viewBox 120x168):
   four colours (diamonds=blue, hearts=red, spades=black, clubs=green), a corner
   index (rank + suit, top left and rotated by 180 degrees at the bottom right),
   the standard pip arrangement for the number cards, a large central symbol for
   the ace and a coloured field with a white pictogram (jack=acorn, queen=crown,
   king=crown) for the court cards. Rank glyphs and suit symbols are
   font-independent vector paths (reused from the bundled cards-simple set). The
   card back (flipside) is a style category of ITS OWN in the QML client
   (data/gfx/qml/backside/<name>/) and NOT part of the card deck.

   Engine index -> card (see CardImage.qml):
     Suit = floor(index / 13): 0-12 diamonds(♦), 13-25 hearts(♥), 26-38 spades(♠), 39-51 clubs(♣)
     Rank = index % 13:        0=2, 1=3, … 8=10, 9=jack, 10=queen, 11=king, 12=ace
-->
<PokerTH>
  <CardDeck>
     <StyleDescription value="Bella Union 4 colours (QML/SVG)" /><!-- Shown in the style selection -->
     <StyleMaintainerName value="Julio Gomez" />
     <StyleMaintainerEMail value="julio.go83@gmail.com" />
     <StyleCreateDate value="19.06.2026" /><!-- QML port; original: 20.07.2009 -->
     <PokerTHStyleFileVersion value="2" /><!-- Matches the version supported by the widget client -->
     <Preview value="preview.png" /><!-- Preview image (landscape only - no portrait needed) -->
     <BigIndexesActionBottom value="0" /><!-- Action labels not necessarily at the bottom -->
  </CardDeck>
</PokerTH>
