<?xml version="1.0" encoding="UTF-8" ?>
<!--
   QML card deck style - a rebuild of the classic "Nobus 4 colours classic"
   widget client card set (nobus_4c_classic) as pure SVG.

   A four colour deck: diamonds=blue, hearts=red, spades=black, clubs=green.
   Every card carries a light, suit-tinted gradient, a corner index (rank letter
   + small suit symbol) and a large central suit symbol.

   Structure (like the bundled cards/default set): 0.svg..51.svg after the
   engine index. The suit paths come from the cards/default set, the rank glyphs
   (2-10, J, Q, K, A) from the cards/bella_union_4c set (strong serif digits,
   embedded as paths independently of any font, coloured in the suit colour).
   The card back is a style category of ITS OWN (data/gfx/qml/backside/).

   Engine index -> card (see CardImage.qml):
     Suit = floor(index / 13): 0-12 diamonds(♦), 13-25 hearts(♥), 26-38 spades(♠), 39-51 clubs(♣)
     Rank = index % 13:        0=2, 1=3, … 8=10, 9=jack, 10=queen, 11=king, 12=ace
-->
<PokerTH>
  <CardDeck>
     <StyleDescription value="Nobus 4 colours classic (QML/SVG)" /><!-- Shown in the style selection -->
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="07.07.2026" />
     <PokerTHStyleFileVersion value="2" /><!-- Matches the version supported by the widget client -->
     <Preview value="preview.png" /><!-- Preview image (landscape only - no portrait needed) -->
     <BigIndexesActionBottom value="0" />
  </CardDeck>
</PokerTH>
