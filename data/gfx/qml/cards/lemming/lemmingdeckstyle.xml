<!--
   QML card deck style "Lemming" – SVG-Nachbau des klassischen PokerTH-Decks
   LEMMING-CARDS-01 von lemming (2021), erzeugt von generate_lemming_deck.py.

   4-Farben-Deck (Karo=blau, Herz=rot, Pik=oliv, Kreuz=grün). Die Kartenfläche
   ist ein einzelner weicher Farbverlauf ohne Rahmen, das große Suit-Symbol in
   der unteren Kartenhälfte ist eine reine Outline ohne Füllung – wie im
   Original.

   Abweichend vom Original steht im Eck-Index der Rang oben und das kleine
   gefüllte Suit-Symbol darunter (im Original umgekehrt).

   Die Rang-Glyphen sind Pfade aus der Montserrat Bold (Google Fonts, OFL, siehe
   data-copyright.txt); Ziffern und Versalien sind dort gleich hoch, die Indizes
   stehen also ohne Nachjustieren auf einer Linie. Die Suit-Pfade stammen wie bei
   den anderen QML-Decks aus dem cards/default-Set.

   Engine-Index -> Karte (siehe CardImage.qml):
     Farbe = floor(index / 13): 0-12 Karo(♦), 13-25 Herz(♥), 26-38 Pik(♠), 39-51 Kreuz(♣)
     Rang  = index % 13:        0=2, 1=3, … 8=10, 9=Bube, 10=Dame, 11=König, 12=Ass
-->
<PokerTH>
  <CardDeck>
     <StyleDescription value="Lemming (QML/SVG)" /><!-- Wird in der Stil-Auswahl angezeigt -->
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="11.07.2026" />
     <PokerTHStyleFileVersion value="2" /><!-- Entspricht der vom Widget-Client unterstützten Version -->
     <Preview value="preview.png" /><!-- Vorschaubild (nur Querformat – kein Portrait nötig) -->
     <BigIndexesActionBottom value="0" />
  </CardDeck>
</PokerTH>
