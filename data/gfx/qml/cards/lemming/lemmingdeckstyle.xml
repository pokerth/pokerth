<?xml version="1.0" encoding="UTF-8" ?>
<!--
   QML card deck style "Lemming" - an SVG rebuild of the classic PokerTH deck
   LEMMING-CARDS-01 by lemming (2021), generated by generate_lemming_deck.py.

   A four colour deck (diamonds=blue, hearts=red, spades=olive, clubs=green).
   The card face is a single soft gradient without a frame, the large suit
   symbol in the lower half of the card is a pure outline without a fill - as in
   the original.

   Differing from the original, the corner index carries the rank at the top and
   the small filled suit symbol below it (the other way round in the original).

   The rank glyphs are paths from Montserrat Bold (Google Fonts, OFL, see
   data-copyright.txt); digits and capitals have the same height there, so the
   indexes line up without any readjustment. The suit paths come from the
   cards/default set, as with the other QML decks.

   Engine index -> card (see CardImage.qml):
     Suit = floor(index / 13): 0-12 diamonds(♦), 13-25 hearts(♥), 26-38 spades(♠), 39-51 clubs(♣)
     Rank = index % 13:        0=2, 1=3, … 8=10, 9=jack, 10=queen, 11=king, 12=ace
-->
<PokerTH>
  <CardDeck>
     <StyleDescription value="Lemming (QML/SVG)" /><!-- Shown in the style selection -->
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="11.07.2026" />
     <PokerTHStyleFileVersion value="2" /><!-- Matches the version supported by the widget client -->
     <Preview value="preview.png" /><!-- Preview image (landscape only - no portrait needed) -->
     <BigIndexesActionBottom value="0" />
  </CardDeck>
</PokerTH>
