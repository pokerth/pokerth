<?xml version="1.0" encoding="UTF-8" ?>
<!--
   QML card deck style.

   Modelled on the widget client card style
   (data/gfx/cards/<name>/<name>deckstyle.xml, root <CardDeck>) and adopting its
   naming convention: the 52 card images are named 0..51 after the engine index.
   The only difference: here all cards are SVG (0.svg .. 51.svg) instead of PNG.
   The card back is a style category of ITS OWN in the QML client
   (data/gfx/qml/backside/<name>/) and NOT part of the card deck.

   Artwork: the simplified small-size layout of the responsive deck
   younestouati/playing-cards-standard-deck (the "mini-card" those cards switch
   to below 75 px), refitted onto the 120x168 card. LGPL 3.0 - the full chain of
   sources is in data/data-copyright.txt.

   Engine index -> card (see CardImage.qml):
     Suit = floor(index / 13): 0-12 diamonds(♦), 13-25 hearts(♥), 26-38 spades(♠), 39-51 clubs(♣)
     Rank = index % 13:        0=2, 1=3, … 8=10, 9=jack, 10=queen, 11=king, 12=ace
-->
<PokerTH>
  <CardDeck>
     <StyleDescription value="PokerTH default QML card deck" /><!-- Shown in the style selection -->
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="18.06.2026" />
     <PokerTHStyleFileVersion value="2" /><!-- Matches the version supported by the widget client -->
     <Preview value="preview.png" /><!-- Preview image (landscape only - no portrait needed) -->
     <BigIndexesActionBottom value="0" /><!-- Action labels not necessarily at the bottom -->
  </CardDeck>
</PokerTH>
