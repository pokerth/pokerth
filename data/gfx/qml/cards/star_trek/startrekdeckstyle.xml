<!--
   QML card deck style "Star Trek" - the counterpart to the card back
   data/gfx/qml/backside/star_trek/.

   A card face with the gold frame of the card back (#f5c276), set off by a dark
   shadow edge and a light edge - the same bevel as in xanax_card_deck_01. A
   four colour deck: diamonds=blue, hearts=red, spades=black, clubs=green, each
   with a clearly visible, suit-tinted gradient.

   The arrangement of rank index and suit symbols follows
   cards/nobus_4c_classic: rank at the top left, the small suit symbol below it,
   the large suit symbol at the bottom right. The rank glyphs are paths from PT
   Serif Bold (Google Fonts, OFL, see data-copyright.txt) - digits and capitals
   have the same height there, so the indexes line up without any readjustment.
   The suit paths come from the cards/default set, as with the other QML decks.

   Engine index -> card (see CardImage.qml):
     Suit = floor(index / 13): 0-12 diamonds(♦), 13-25 hearts(♥), 26-38 spades(♠), 39-51 clubs(♣)
     Rank = index % 13:        0=2, 1=3, … 8=10, 9=jack, 10=queen, 11=king, 12=ace
-->
<PokerTH>
  <CardDeck>
     <StyleDescription value="Star Trek (QML/SVG)" /><!-- Shown in the style selection -->
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="10.07.2026" />
     <PokerTHStyleFileVersion value="2" /><!-- Matches the version supported by the widget client -->
     <Preview value="preview.png" /><!-- Preview image (landscape only - no portrait needed) -->
     <BigIndexesActionBottom value="0" />
  </CardDeck>
</PokerTH>
