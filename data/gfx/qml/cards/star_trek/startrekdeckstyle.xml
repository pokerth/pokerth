<?xml version="1.0" encoding="UTF-8" ?>
<!--
   QML card deck style "Star Trek" – Gegenstück zur Kartenrückseite
   data/gfx/qml/backside/star_trek/.

   Kartenfläche mit dem Goldrahmen der Rückseite (#f5c276), abgesetzt durch eine
   dunkle Schatten- und eine helle Lichtkante – dieselbe Fase wie beim
   xanax_card_deck_01. 4-Farben-Deck: Karo=blau, Herz=rot, Pik=schwarz,
   Kreuz=grün, jeweils mit einem deutlich sichtbaren, suit-getönten Farbverlauf.

   Anordnung von Rang-Index und Suit-Symbolen wie bei cards/nobus_4c_classic:
   Rang oben links, kleines Suit-Symbol darunter, großes Suit-Symbol unten
   rechts. Die Rang-Glyphen sind Pfade aus der PT Serif Bold (Google Fonts, OFL,
   siehe data-copyright.txt) – dort sind Ziffern und Versalien gleich hoch, die
   Indizes stehen also ohne Nachjustieren auf einer Linie. Die Suit-Pfade
   stammen wie bei den anderen QML-Decks aus dem cards/default-Set.

   Engine-Index -> Karte (siehe CardImage.qml):
     Farbe = floor(index / 13): 0-12 Karo(♦), 13-25 Herz(♥), 26-38 Pik(♠), 39-51 Kreuz(♣)
     Rang  = index % 13:        0=2, 1=3, … 8=10, 9=Bube, 10=Dame, 11=König, 12=Ass
-->
<PokerTH>
  <CardDeck>
     <StyleDescription value="Star Trek (QML/SVG)" /><!-- Wird in der Stil-Auswahl angezeigt -->
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="10.07.2026" />
     <PokerTHStyleFileVersion value="2" /><!-- Entspricht der vom Widget-Client unterstützten Version -->
     <Preview value="preview.png" /><!-- Vorschaubild (nur Querformat – kein Portrait nötig) -->
     <BigIndexesActionBottom value="0" />
  </CardDeck>
</PokerTH>
