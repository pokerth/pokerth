<?xml version="1.0" encoding="UTF-8" ?>
<!--
   QML card back style (Kartenrückseite) "Matrix".

   Matrix "Digital Rain": Spalten vertikal fallender Zeichen auf Schwarz, der
   Kopf jedes Streams hell weiß-grün, der Schweif zu Dunkelgrün ausfadend. Die
   Zeichen sind gespiegelte Halfwidth-Katakana (wie im Film) plus einige Ziffern,
   als SVG-Pfade eingebacken (kein <text>/<use>/Filter -> QtSvg-sicher). Rahmen
   wie die neuesten Decks (stardust-Rückseite), in Grün. Dateinamen sind relativ
   zu diesem XML zu verstehen.

   Erzeugt mit generate_matrix_backside.py.
-->
<PokerTH>
  <CardBack>
     <StyleDescription value="Matrix (QML/SVG)" /><!-- Wird in der Stil-Auswahl angezeigt -->
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="10.07.2026" />
     <PokerTHStyleFileVersion value="1" />
     <Preview value="preview.png" /><!-- Vorschaubild (nur Querformat – kein Portrait nötig) -->

     <!-- Rückseiten-Grafik (SVG, beliebig skalierbar) -->
     <Backside value="backside.svg" />
  </CardBack>
</PokerTH>
