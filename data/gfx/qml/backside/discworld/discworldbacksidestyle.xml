<?xml version="1.0" encoding="UTF-8" ?>
<!--
   QML card back style (Kartenrückseite) "Discworld".

   Great A'Tuin trägt die Scheibenwelt. Gold auf dunklem Braun – dieselbe
   Palette wie der Discworld-Tischstil (data/gfx/qml/table/discworld/), damit
   Tisch, Pucks und Kartenrücken zusammen gelesen werden.

   Das Emblem ist eine Bitmap-Vektorisierung (atuin.svg, 1,3 MB, 1874 Pfade)
   und für die Karte auf Motivgröße reduziert – Verfahren siehe
   ../../cards/discworld/discworlddeckstyle.xml, hier mit Toleranz 2 und
   Mindestfläche 10 bei Zeichenfläche 1024x1024 (1,3 MB -> 109 KB). Die
   feineren Werte als bei den Vorderseiten-Motiven sind nötig, weil die
   Schuppen der Flossen sonst zu grob werden.

   preview.png ist die auf 424x561 gezogene backside.svg (Standardmaß aller
   Rückseiten-Vorschauen, leicht breiter als das 580x800 der Grafik).

   Dateinamen sind relativ zu diesem XML zu verstehen.
-->
<PokerTH>
  <CardBack>
     <StyleDescription value="Discworld (QML/SVG)" /><!-- Wird in der Stil-Auswahl angezeigt -->
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="19.07.2026" />
     <PokerTHStyleFileVersion value="1" />
     <Preview value="preview.png" /><!-- Vorschaubild (nur Querformat – kein Portrait nötig) -->

     <!-- Rückseiten-Grafik (SVG, beliebig skalierbar) -->
     <Backside value="backside.svg" />
  </CardBack>
</PokerTH>
