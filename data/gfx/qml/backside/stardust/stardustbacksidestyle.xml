<?xml version="1.0" encoding="UTF-8" ?>
<!--
   QML card back style "Stardust".

   The counterpart to the card deck data/gfx/qml/cards/stardust/. A dark "space"
   card with a blue gradient, a star field and a glowing cyan bevel frame (like
   the card faces). The central emblem is a stardust sparkle with a halo - pure
   SVG paths and gradients (no <use>/filters), so that QtSvg renders it
   reliably. File names are relative to this XML.
-->
<PokerTH>
  <CardBack>
     <StyleDescription value="Stardust (QML/SVG)" /><!-- Shown in the style selection -->
     <StyleMaintainerName value="PokerTH Development Team" />
     <StyleMaintainerEMail value="webmaster@pokerth.net" />
     <StyleCreateDate value="10.07.2026" />
     <PokerTHStyleFileVersion value="1" />
     <Preview value="preview.png" /><!-- Preview image (landscape only - no portrait needed) -->

     <!-- Card back graphic (SVG, scalable to any size) -->
     <Backside value="backside.svg" />
  </CardBack>
</PokerTH>
