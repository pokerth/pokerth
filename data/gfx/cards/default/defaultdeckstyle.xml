<?xml version="1.0" encoding="UTF-8" ?>
<PokerTH>
  <CardDeck>
	<StyleDescription value="PokerTH old default card deck" /> <!-- This string will be shown in settings/game table style list -->
	<StyleMaintainerName value="PokerTH Development Team" /> <!-- This string should contain the name of the style maintainer and will be shown in style information -->
        <StyleMaintainerEMail value="webmaster@pokerth.net" /> <!-- This string should contain the email address of the style maintainer and will be shown in the style information and in an error message if there is a problem with the style. If you do not want to publish your email address here, set value="NULL". -->
	<StyleCreateDate value="04.04.2009" /> <!-- This string should contain the creation date or most recent modification date and will be shown in style information-->
	<PokerTHStyleFileVersion value="2" /> <!-- This is the current PokerTH style-file version supported by the client. Change it only when instructed by PokerTH. -->
	<Preview value="preview.png" /> <!-- This preview image is shown in the card deck style list when the style is selected. Its value must be the file name of an image in the same directory as this XML file. -->
	<BigIndexesActionBottom value="0" /> <!-- This switch forces action labels such as check, call, and bet to appear at the bottom of the cards. Useful for very large index cards such as the 1.0 deck -->
  </CardDeck>
</PokerTH>
