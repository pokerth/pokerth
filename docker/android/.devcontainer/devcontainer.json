// Android devcontainer. Single source of truth: devcontainer.json (no docker-compose).
// VS Code and make android-docker both use this config. See docs/building-developer.md.
{
    "name": "Android Development Container",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "../../..",
        "options": ["--platform=linux/amd64"]
    },
    "runArgs": ["--platform", "linux/amd64"],
    "workspaceFolder": "/workspaces/pokerth",
    "workspaceMount": "source=${localWorkspaceFolder}/../..,target=/workspaces/pokerth,type=bind,consistency=cached",
    "mounts": [
        "source=${localWorkspaceFolder}/build/vcpkg,target=/opt/pokerth-android/vcpkg,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "VCPKG_DIR": "/opt/pokerth-android/vcpkg",
        "ANDROID_CACHE_ROOT": "/opt/pokerth-android"
    },
    // Features to add to the dev container. More info: https://containers.dev/features.
    // "features": {},
    // Configure tool-specific properties.
    // "customizations": {},
    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    // "forwardPorts": [
    //     8080
    // ],
    // "features": {
    //     "ghcr.io/devcontainers/features/node:1": {
    //         "version": "lts",
    //         "pnpmVersion": "latest",
    //         "nvmVersion": "latest"
    //     }
    // },
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-containers",
                "ms-ceintl.vscode-language-pack-de",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cmake-tools",
                "ms-azuretools.vscode-docker",
                "github.vscode-github-actions",
                "esbenp.prettier-vscode",
                "aswinkumar863.sort-editors"
            ]
        }
    }
}
