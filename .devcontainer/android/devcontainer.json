// Android devcontainer. Image: docker/android/Dockerfile.
// ROOT / ANDROID_CACHE_ROOT: SDK/NDK in image. vcpkg/Qt: functions.sh when IN_DOCKER=1 (same as make *-docker).
{
    "name": "Android Development Container",
    "build": {
        "dockerfile": "../../docker/android/Dockerfile",
        "context": "../..",
        "options": ["--platform=linux/amd64"]
    },
    "runArgs": ["--platform", "linux/amd64"],
    "workspaceFolder": "/workspaces/pokerth",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/pokerth,type=bind,consistency=cached",
    "containerEnv": {
        "ROOT": "/opt/pokerth-android",
        "ANDROID_CACHE_ROOT": "/opt/pokerth-android",
        "IN_DEVCONTAINER": "1"
    },
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-containers",
                "ms-ceintl.vscode-language-pack-de",
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cmake-tools",
                "ms-azuretools.vscode-docker",
                "github.vscode-github-actions",
                "esbenp.prettier-vscode",
                "aswinkumar863.sort-editors"
            ]
        }
    }
}
